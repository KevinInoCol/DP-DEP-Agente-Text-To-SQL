# LLM
OPENAI_API_KEY=sk-...

# Proyecto de GCP que paga las consultas (la tabla es pública; el cobro va a tu proyecto).
# Autenticación: gcloud auth application-default login
# o bien una cuenta de servicio con rol BigQuery Job User (+ Data Viewer si no es tabla pública):
GOOGLE_APPLICATION_CREDENTIALS=credentials/mi-service-account.json
GOOGLE_CLOUD_PROJECT=mi-proyecto-gcp

# Límites de seguridad de la tool de BigQuery (opcionales)
BQ_MAX_BYTES_BILLED=5368709120    # 5 GB por consulta (la tabla completa pesa ~7.5 GB; SELECT * queda fuera)
BQ_MAX_ROWS=100
BQ_TIMEOUT_SECONDS=60

# Dónde guardar el feedback de los usuarios (opcional)
FEEDBACK_PATH=feedback/feedback.jsonl

# Búsqueda web complementaria (opcional). Sin esta key el agente funciona sin internet.
# Key gratuita en https://tavily.com (empieza por tvly-)
TAVILY_API_KEY=tvly-...
TAVILY_MAX_RESULTADOS=4
TAVILY_SEARCH_DEPTH=basic
